  default-language:    Haskell2010
  build-depends:       base >= 4.7 && < 5
                     , vector
                     , massiv
                     , hmatrix
                     , bytestring
                     , binary
                     , text
                     , containers
                     , mtl
                     , transformers
                     , filepath
                     , directory
                     , ad
  pkgconfig-depends:   netcdf
  ghc-options:         -Wall
                       -Wcompat
                       -Widentities
                       -Wincomplete-record-updates
                       -Wincomplete-uni-patterns
                       -Wmissing-export-lists
                       -Wredundant-constraints
                       -O2

executable clm-hs
  hs-source-dirs:      app
  main-is:             Main.hs
  default-language:    Haskell2010
  build-depends:       base >= 4.7 && < 5
                     , CLM-hs
                     , vector
                     , filepath
  ghc-options:         -Wall -threaded -rtsopts -with-rtsopts=-N

test-suite clm-hs-test
  type:                exitcode-stdio-1.0
  hs-source-dirs:      test
  main-is:             Spec.hs
  default-language:    Haskell2010
  build-depends:       base >= 4.7 && < 5
                     , CLM-hs
                     , vector
                     , hspec
                     , QuickCheck
                     , directory
                     , filepath
                     , containers
                     , ad
  ghc-options:         -Wall -threaded -rtsopts -with-rtsopts=-N
